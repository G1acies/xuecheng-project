# ============================================================
# 复制为 .env 并按需修改（.env 已被 .gitignore 忽略，不会提交）
# 也可以直接导出为环境变量，或在 Nacos 配置中心中配置同名属性
# ============================================================

# ---------- Nacos ----------
# 对应 bootstrap.yml 中的 spring.cloud.nacos.server-addr
NACOS_ADDR=127.0.0.1:8848

# ---------- JWT ----------
# 必填。认证服务与所有资源服务必须使用相同的密钥，否则令牌无法校验。
# 生成示例：openssl rand -base64 48
JWT_SIGNING_KEY=please-change-me-to-a-long-random-string

# ---------- OAuth2 客户端 ----------
OAUTH_CLIENT_ID=XcWebApp
OAUTH_CLIENT_SECRET=please-change-me

# ---------- 微信开放平台（扫码登录，可选） ----------
WEIXIN_APPID=
WEIXIN_SECRET=

# ---------- 代码生成器 ----------
DB_HOST=localhost
DB_USERNAME=root
DB_PASSWORD=

# ---------- 中间件地址（在 Nacos 配置中心中通常也会配置） ----------
# MySQL / Redis / MinIO / Elasticsearch / RabbitMQ 的连接信息
# 建议放在 Nacos 的 application-{profile}.yaml 中，不要提交到仓库
